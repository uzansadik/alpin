# ---------------------------------------------------------------------------
# Alpin environment template
#
#   cp .env.example .env
#
# `.env` repoya commit edilmez. Bu dosya yalnızca değişken isimlerini ve
# beklenen formatı gösterir.
#
# Nerede kullanılır:
#   - Lokal geliştirme: `pnpm dev` (root `.env` → `apps/qms/.env` senkronlanır)
#   - Docker: `docker compose up` (compose `env_file: .env` ile okur)
#   - CI: GitHub Actions Secrets / Variables (aşağıdaki "GitHub" bölümüne bak)
# ---------------------------------------------------------------------------

# --- Uygulama ---------------------------------------------------------------

# local | staging | production
APP_ENV=local

# Uygulamanın public URL'i. NEXT_PUBLIC_* olduğu için client bundle'a
# build sırasında işlenir: GitHub'da bu değişken tanımlıysa CI image'ına
# gömülür, tanımlı değilse CI build'i başarısız olur.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Uygulama portu (sadece docker compose için)
APP_PORT=3000

# --- Veritabanı -------------------------------------------------------------

# Docker Compose bu değeri kendisi ezen servisler arasında
# `postgres:5432` olarak override eder.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alpin

# --- Redis / Kuyruk ---------------------------------------------------------

REDIS_URL=redis://localhost:6379

# BullMQ queue prefix'i. Aynı Redis instance'ını paylaşan uygulamalar
# farklı prefix kullanmalı.
QUEUE_PREFIX=alpin

# Worker'ın dinlediği queue'lar (virgülle ayrılmış)
WORKER_QUEUES=default,email

# --- Kimlik doğrulama -------------------------------------------------------

# En az 32 karakter. Üretimde openssl rand -base64 32 ile üret.
BETTER_AUTH_SECRET=

# Better Auth'in public URL'i. NEXT_PUBLIC_APP_URL ile aynı olmalı.
# Yanlış tanımlanırsa (örn. mqdms issuer'ı) tarayıcı origin'i güvenilir
# listede bulunamaz ve giriş `INVALID_ORIGIN` hatasıyla kırılır.
BETTER_AUTH_URL=http://localhost:3000

# CSRF koruması için ek güvenilir origin'ler (virgülle ayrılmış).
# Uygulamanın public URL'i zaten otomatik eklenir.
BETTER_AUTH_TRUSTED_ORIGINS=

# --- mqdms (OAuth 2.1 / OIDC sağlayıcısı) -----------------------------------

# Alpin'in tek kimlik sağlayıcısı mqdms'tir. mqdms'te "Alpin Web" adlı
# OAuth client kaydı oluşturulur (auth.mqdms.com/admin/oauth-clients).
#
# Token endpoint auth method `none` olan public client kullanılıyorsa
# secret boş bırakılır; PKCE (S256) zorunludur.

# Issuer (yetkilendirme sunucusu). Değiştirmeye gerek yok.
MQDMS_ISSUER=https://auth.mqdms.com

# Client id. mqdms client kaydından kopyalanır. ZORUNLU.
MQDMS_CLIENT_ID=

# Client secret. Public client'ta boş bırakılır. ASLA commit edilmez.
MQDMS_CLIENT_SECRET=

# Callback URI. Boş bırakılırsa ${NEXT_PUBLIC_APP_URL}/api/auth/callback/mqdms
# kullanılır. mqdms'te kayıtlı olmalıdır.
MQDMS_REDIRECT_URI=

# RFC 8707 `resource` değeri. Boş bırakılırsa NEXT_PUBLIC_APP_URL kullanılır.
# mqdms'te kayıtlı ve client'a bağlı olmalıdır.
MQDMS_RESOURCE=

# --- E-posta ----------------------------------------------------------------

# Resend API key
RESEND_API_KEY=

# Gönderen e-posta adresi (Resend'de doğrulanmış olmalı)
RESEND_FROM_EMAIL=

# --- Depolama (S3 / R2 uyumlu) -----------------------------------------------

STORAGE_BUCKET=
STORAGE_REGION=auto

# S3 uyumlu servis için erişim bilgileri
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Opsiyonel: custom endpoint (R2 vb.). AWS S3 kullanılıyorsa boş bırakılabilir.
STORAGE_ENDPOINT=

# Opsiyonel: public URL prefix'i (CDN). Boş bırakılabilir.
STORAGE_PUBLIC_URL=
